{
  "name": "warpgate",
  "displayName": "WarpGate",
  "description": "SSH server management with workspace-scoped server lists, SSH config import, and terminal-based connections",
  "version": "0.1.1",
  "publisher": "j2p2",
  "license": "MIT",
  "icon": "resources/warpgate-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jignesh/warpgate"
  },
  "homepage": "https://github.com/jignesh/warpgate#readme",
  "bugs": {
    "url": "https://github.com/jignesh/warpgate/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ssh",
    "remote",
    "terminal",
    "server",
    "connection"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "warpgate",
          "title": "WarpGate",
          "icon": "resources/warpgate.svg"
        }
      ]
    },
    "views": {
      "warpgate": [
        {
          "id": "warpgateServers",
          "name": "Servers",
          "icon": "resources/warpgate.svg",
          "contextualTitle": "WarpGate"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "warpgateServers",
        "contents": "No servers configured yet.\n[Add Server](command:warpgate.addServer)\n[Import from SSH Config](command:warpgate.importFromConfig)"
      }
    ],
    "commands": [
      {
        "command": "warpgate.addServer",
        "title": "WarpGate: Add Server",
        "icon": "$(add)",
        "category": "WarpGate"
      },
      {
        "command": "warpgate.editServer",
        "title": "WarpGate: Edit Server",
        "icon": "$(edit)",
        "category": "WarpGate"
      },
      {
        "command": "warpgate.deleteServer",
        "title": "WarpGate: Delete Server",
        "icon": "$(trash)",
        "category": "WarpGate"
      },
      {
        "command": "warpgate.bulkDelete",
        "title": "WarpGate: Bulk Delete Servers & Groups",
        "icon": "$(trash)",
        "category": "WarpGate"
      },
      {
        "command": "warpgate.connectServer",
        "title": "WarpGate: Connect",
        "icon": "$(terminal)",
        "category": "WarpGate"
      },
      {
        "command": "warpgate.renameServer",
        "title": "WarpGate: Rename Server",
        "category": "WarpGate"
      },
      {
        "command": "warpgate.duplicateServer",
        "title": "WarpGate: Duplicate Server",
        "category": "WarpGate"
      },
      {
        "command": "warpgate.importFromConfig",
        "title": "WarpGate: Import from SSH Config",
        "icon": "$(cloud-download)",
        "category": "WarpGate"
      },
      {
        "command": "warpgate.createGroup",
        "title": "WarpGate: Create Group",
        "icon": "$(new-folder)",
        "category": "WarpGate"
      },
      {
        "command": "warpgate.deleteGroup",
        "title": "WarpGate: Delete Group",
        "category": "WarpGate"
      },
      {
        "command": "warpgate.moveToGroup",
        "title": "WarpGate: Move to Group",
        "category": "WarpGate"
      },
      {
        "command": "warpgate.copySSHCommand",
        "title": "WarpGate: Copy SSH Command",
        "category": "WarpGate"
      },
      {
        "command": "warpgate.refresh",
        "title": "WarpGate: Refresh",
        "icon": "$(refresh)",
        "category": "WarpGate"
      },
      {
        "command": "warpgate.portForward",
        "title": "WarpGate: Port Forward (Tunnel)",
        "icon": "$(plug)",
        "category": "WarpGate"
      },
      {
        "command": "warpgate.generateSSHKey",
        "title": "WarpGate: Generate SSH Key",
        "icon": "$(key)",
        "category": "WarpGate"
      },
      {
        "command": "warpgate.exportConfig",
        "title": "WarpGate: Export Server Config",
        "icon": "$(cloud-upload)",
        "category": "WarpGate"
      },
      {
        "command": "warpgate.importConfig",
        "title": "WarpGate: Import Server Config",
        "icon": "$(cloud-download)",
        "category": "WarpGate"
      },
      {
        "command": "warpgate.quickConnect",
        "title": "WarpGate: Quick Connect",
        "icon": "$(zap)",
        "category": "WarpGate"
      }
    ],
    "keybindings": [
      {
        "command": "warpgate.quickConnect",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "warpgate.addServer",
          "when": "view == warpgateServers",
          "group": "navigation@1"
        },
        {
          "command": "warpgate.importFromConfig",
          "when": "view == warpgateServers",
          "group": "navigation@2"
        },
        {
          "command": "warpgate.createGroup",
          "when": "view == warpgateServers",
          "group": "navigation@3"
        },
        {
          "command": "warpgate.refresh",
          "when": "view == warpgateServers",
          "group": "navigation@4"
        },
        {
          "command": "warpgate.bulkDelete",
          "when": "view == warpgateServers",
          "group": "overflow@1"
        }
      ],
      "view/item/context": [
        {
          "command": "warpgate.connectServer",
          "when": "view == warpgateServers && viewItem == sshServer",
          "group": "inline@1"
        },
        {
          "command": "warpgate.editServer",
          "when": "view == warpgateServers && viewItem == sshServer",
          "group": "1_actions@1"
        },
        {
          "command": "warpgate.renameServer",
          "when": "view == warpgateServers && viewItem == sshServer",
          "group": "1_actions@2"
        },
        {
          "command": "warpgate.duplicateServer",
          "when": "view == warpgateServers && viewItem == sshServer",
          "group": "1_actions@3"
        },
        {
          "command": "warpgate.moveToGroup",
          "when": "view == warpgateServers && viewItem == sshServer",
          "group": "2_organize@1"
        },
        {
          "command": "warpgate.portForward",
          "when": "view == warpgateServers && viewItem == sshServer",
          "group": "1_actions@4"
        },
        {
          "command": "warpgate.copySSHCommand",
          "when": "view == warpgateServers && viewItem == sshServer",
          "group": "3_clipboard@1"
        },
        {
          "command": "warpgate.deleteServer",
          "when": "view == warpgateServers && viewItem == sshServer",
          "group": "4_danger@1"
        },
        {
          "command": "warpgate.deleteGroup",
          "when": "view == warpgateServers && viewItem == sshGroup",
          "group": "4_danger@1"
        }
      ]
    },
    "configuration": {
      "title": "WarpGate",
      "properties": {
        "warpgate.sshBinaryPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to SSH binary. Leave empty to auto-detect from PATH. (Machine-scoped: cannot be overridden by workspace settings.)"
        },
        "warpgate.defaultPort": {
          "type": "number",
          "default": 22,
          "description": "Default SSH port for new servers."
        },
        "warpgate.defaultUsername": {
          "type": "string",
          "default": "",
          "description": "Default username for new servers. Leave empty to use system username."
        },
        "warpgate.confirmBeforeDelete": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Show confirmation dialog before deleting servers or groups. (Machine-scoped: cannot be overridden by workspace settings.)"
        },
        "warpgate.showConnectionNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notification when connecting to a server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc -noEmit",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  }
}
